const COLUMN_BILL_NUMBER = 2; // Cột B: transaction_code
const MONEY_AMOUNT_NUMBER = 3; // Cột C: money_amount

function extractBankAndRef(text) {
  const regex = /ທະນາຄານ:\s*([A-Z]+).*?ເລກອ້າງອີງຮ້ານຄ້າ:\s*([A-Z0-9]+)/;
  const match = text.match(regex);
  if (!match) return text;
  
  const bank = match[1];
  const merchantRef = match[2];
  return `${bank} | ${merchantRef}`;
}

function addRecord(fullname, transaction_code, money_amount, time, type) {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var sheetName = (type === "NHAN") ? "NHAN_TIEN" : "CHUYEN_TIEN";
  var sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    return { "status": "error", "message": "Không tìm thấy sheet: " + sheetName };
  }
  
  if (!transaction_code) {
    return { "status": "error", "message": "Thiếu mã transaction_code" };
  }

  var lastRow = sheet.getLastRow();
  
  // LOGIC KIỂM TRA
  if (lastRow > 1) {
    // Lấy dữ liệu từ cột B (Mã) và C (Tiền)
    var dataRange = sheet.getRange(2, COLUMN_BILL_NUMBER, lastRow - 1, 2).getValues();
    
    // Tìm xem đã có bản ghi nào trùng CẢ mã VÀ tiền chưa
    var isDuplicateEntry = dataRange.some(function(row) {
      var existingCode = String(row[0]);
      var existingAmount = String(row[1]);
      
      return existingCode === String(transaction_code) && existingAmount === String(money_amount);
    });

    if (isDuplicateEntry) {
      return { 
        "status": "error", 
        "message": "Giao dịch này (Mã: " + transaction_code + " - Số tiền: " + money_amount + ") đã tồn tại!" 
      };
    }
  }

  sheet.appendRow([fullname, transaction_code, money_amount, time]);
  
  return { "status": "success", "message": "Đã thêm dữ liệu thành công!" };
}


function doPost(e) {
  try {
    var data = JSON.parse(e.postData.contents);
    var type = data.type;
    var time = data.time || "";
    var fullname = data.fullname || "";
    var transaction_code = data.transaction_code;
    var money_amount = data.money_amount;

    if (fullname.includes("QR")) {
      var parts = fullname.split("|");
      if (parts.length > 5) {
        fullname = parts[5];
      }
    }

    if (type !== "NHAN") {
      fullname = extractBankAndRef(fullname);
    }

    var result = addRecord(fullname, transaction_code, money_amount, time, type);

    return ContentService.createTextOutput(JSON.stringify(result))
      .setMimeType(ContentService.MimeType.JSON);

  } catch (error) {
    return ContentService.createTextOutput(JSON.stringify({ "status": "error", "message": error.message }))
      .setMimeType(ContentService.MimeType.JSON);
  }
}

function doGet(e) {
  var status = {
    "status": "active",
    "message": "API Spreadsheet đang hoạt động bình thường!",
    "timestamp": new Date().toLocaleString(),
    "version":"1.0.1"
  };
  return ContentService.createTextOutput(JSON.stringify(status))
    .setMimeType(ContentService.MimeType.JSON);
}
